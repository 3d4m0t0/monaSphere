#version 450
// One opaque BC1 block per thread. Endpoints follow the block's color axis.
layout(local_size_x = 64) in;

layout(std430, set = 0, binding = 0) readonly buffer Src { uint pixels[]; };
layout(std430, set = 0, binding = 1) writeonly buffer Dst { uint blocks[]; };

layout(push_constant) uniform Push {
  uint src_w;
  uint src_h;
  uint blocks_x;
  uint blocks_y;
  uint block_base;
} pc;

uint src_at(int x, int y) {
  x = clamp(x, 0, int(pc.src_w) - 1);
  y = clamp(y, 0, int(pc.src_h) - 1);
  return pixels[uint(y) * pc.src_w + uint(x)];
}

uint to_565(ivec3 c) {
  c = clamp(c, ivec3(0), ivec3(255));
  uint r = uint((c.x * 31 + 127) / 255);
  uint g = uint((c.y * 63 + 127) / 255);
  uint b = uint((c.z * 31 + 127) / 255);
  return (r << 11u) | (g << 5u) | b;
}

ivec3 from_565(uint c) {
  uint r = (c >> 11u) & 31u;
  uint g = (c >> 5u) & 63u;
  uint b = c & 31u;
  return ivec3(int((r << 3u) | (r >> 2u)), int((g << 2u) | (g >> 4u)), int((b << 3u) | (b >> 2u)));
}

void main() {
  uint id = gl_GlobalInvocationID.x + pc.block_base;
  uint nblocks = pc.blocks_x * pc.blocks_y;
  if (id >= nblocks) return;
  uint bx = id % pc.blocks_x;
  uint by = id / pc.blocks_x;

  vec3 pix[16];
  vec3 mean = vec3(0.0);
  for (int i = 0; i < 16; ++i) {
    int x = int(bx) * 4 + (i & 3);
    int y = int(by) * 4 + (i >> 2);
    uint p = src_at(x, y);
    pix[i] = vec3(float(p & 255u), float((p >> 8u) & 255u), float((p >> 16u) & 255u));
    mean += pix[i];
  }
  mean *= (1.0 / 16.0);

  vec3 axis = vec3(0.0);
  for (int i = 0; i < 16; ++i) axis += abs(pix[i] - mean);
  if (dot(axis, axis) < 1.0) axis = vec3(1.0, 1.0, 1.0);
  axis = normalize(axis);
  for (int it = 0; it < 4; ++it) {
    vec3 next = vec3(0.0);
    for (int i = 0; i < 16; ++i) {
      vec3 d = pix[i] - mean;
      next += d * dot(d, axis);
    }
    float len2 = dot(next, next);
    if (len2 < 1e-4) break;
    axis = next * inversesqrt(len2);
  }

  int imin = 0;
  int imax = 0;
  float tmin = 1e9;
  float tmax = -1e9;
  for (int i = 0; i < 16; ++i) {
    float t = dot(pix[i] - mean, axis);
    if (t < tmin) { tmin = t; imin = i; }
    if (t > tmax) { tmax = t; imax = i; }
  }
  vec3 a = pix[imin];
  vec3 b = pix[imax];
  vec3 inset = (b - a) * (1.0 / 16.0);
  a = clamp(a + inset, vec3(0.0), vec3(255.0));
  b = clamp(b - inset, vec3(0.0), vec3(255.0));

  // One least-squares pass so the endpoints sit on the pixels, not on two outliers.
  float AtA00 = 0.0;
  float AtA01 = 0.0;
  float AtA11 = 0.0;
  vec3 Atb0 = vec3(0.0);
  vec3 Atb1 = vec3(0.0);
  float span = max(tmax - tmin, 1.0);
  for (int i = 0; i < 16; ++i) {
    float t = clamp((dot(pix[i] - mean, axis) - tmin) / span, 0.0, 1.0);
    float w0 = 1.0 - t;
    AtA00 += w0 * w0;
    AtA01 += w0 * t;
    AtA11 += t * t;
    Atb0 += w0 * pix[i];
    Atb1 += t * pix[i];
  }
  float det = AtA00 * AtA11 - AtA01 * AtA01;
  if (det > 1.0) {
    a = clamp((AtA11 * Atb0 - AtA01 * Atb1) / det, vec3(0.0), vec3(255.0));
    b = clamp((AtA00 * Atb1 - AtA01 * Atb0) / det, vec3(0.0), vec3(255.0));
  }

  uint c0 = to_565(ivec3(a + 0.5));
  uint c1 = to_565(ivec3(b + 0.5));
  ivec3 d0 = from_565(c0);
  ivec3 d1 = from_565(c1);
  ivec3 pal[4];
  pal[0] = d0;
  pal[1] = d1;
  pal[2] = (2 * d0 + d1) / 3;
  pal[3] = (d0 + 2 * d1) / 3;

  uint indices = 0u;
  for (int i = 0; i < 16; ++i) {
    uint best = 0u;
    int best_err = 1 << 30;
    ivec3 c = ivec3(pix[i] + 0.5);
    for (uint k = 0u; k < 4u; ++k) {
      ivec3 d = pal[k] - c;
      int e = d.x * d.x + d.y * d.y + d.z * d.z;
      if (e < best_err) { best_err = e; best = k; }
    }
    indices |= best << uint(i * 2);
  }

  if (c0 < c1) {
    uint tmp = c0;
    c0 = c1;
    c1 = tmp;
    uint swapped = 0u;
    for (int i = 0; i < 16; ++i) {
      uint k = (indices >> uint(i * 2)) & 3u;
      swapped |= (k ^ 1u) << uint(i * 2);
    }
    indices = swapped;
  } else if (c0 == c1) {
    if (c0 > 0u) c1 = c0 - 1u;
    else c0 = 1u;
  }

  blocks[id * 2u] = (c0 & 0xffffu) | ((c1 & 0xffffu) << 16u);
  blocks[id * 2u + 1u] = indices;
}
