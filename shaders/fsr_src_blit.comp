#version 450
// Convert video source (RGBA or NV12) into an RGBA8 texture for FSR1.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform blit_params {
  uint width;
  uint height;
  uint nv12;       // 0=RGBA, 1=limited, 2=full
  uint _pad;
};

layout(set = 0, binding = 1) uniform sampler2D srcY;   // RGBA or Y
layout(set = 0, binding = 2) uniform sampler2D srcUV;  // UV or unused
layout(set = 0, binding = 3, rgba8) uniform image2D dst;

vec3 yuv_to_rgb_limited(float y, float u, float v) {
  y = (y - 16.0 / 255.0) * (255.0 / 219.0);
  u = (u - 128.0 / 255.0) * (255.0 / 224.0);
  v = (v - 128.0 / 255.0) * (255.0 / 224.0);
  float r = y + 1.5748 * v;
  float g = y - 0.1873 * u - 0.4681 * v;
  float b = y + 1.8556 * u;
  return clamp(vec3(r, g, b), 0.0, 1.0);
}

vec3 yuv_to_rgb_full(float y, float u, float v) {
  u = u - 0.5;
  v = v - 0.5;
  float r = y + 1.5748 * v;
  float g = y - 0.1873 * u - 0.4681 * v;
  float b = y + 1.8556 * u;
  return clamp(vec3(r, g, b), 0.0, 1.0);
}

// CPU RGBA is VK_FORMAT_R8G8B8A8_SRGB, so the sample is already linear.
// FSR and the scene shader expect gamma, same as the NV12 blit.
vec3 linear_to_srgb(vec3 c) {
  bvec3 cutoff = lessThanEqual(c, vec3(0.0031308));
  vec3 low = c * 12.92;
  vec3 high = 1.055 * pow(max(c, vec3(0.0)), vec3(1.0 / 2.4)) - 0.055;
  return mix(high, low, cutoff);
}

// 4:2:0 chroma is half the luma resolution. Catmull-Rom from four bilinear taps.
vec2 sample_chroma(sampler2D tex, vec2 uv) {
  vec2 texSize = vec2(textureSize(tex, 0));
  vec2 pc = uv * texSize - 0.5;
  vec2 base = floor(pc);
  vec2 f = pc - base;
  vec2 f2 = f * f;
  vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
  vec2 w1 = 1.0 + f2 * (-2.5 + 1.5 * f);
  vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
  vec2 w3 = f2 * (-0.5 + 0.5 * f);
  vec2 g0 = w0 + w1;
  vec2 g1 = w2 + w3;
  vec2 h0 = w1 / max(g0, vec2(1e-5));
  vec2 h1 = w3 / max(g1, vec2(1e-5));
  vec2 invSize = 1.0 / texSize;
  vec2 p0 = (base - 0.5 + h0) * invSize;
  vec2 p1 = (base + 1.5 + h1) * invSize;
  vec2 s = texture(tex, vec2(p0.x, p0.y)).rg * (g0.x * g0.y);
  s += texture(tex, vec2(p1.x, p0.y)).rg * (g1.x * g0.y);
  s += texture(tex, vec2(p0.x, p1.y)).rg * (g0.x * g1.y);
  s += texture(tex, vec2(p1.x, p1.y)).rg * (g1.x * g1.y);
  return clamp(s, 0.0, 1.0);
}

void main() {
  ivec2 p = ivec2(gl_GlobalInvocationID.xy);
  if (p.x >= int(width) || p.y >= int(height)) return;
  vec2 uv = (vec2(p) + 0.5) / vec2(float(width), float(height));
  vec3 rgb;
  if (nv12 != 0u) {
    float y = texture(srcY, uv).r;
    vec2 chroma = sample_chroma(srcUV, uv);
    rgb = (nv12 == 2u) ? yuv_to_rgb_full(y, chroma.r, chroma.g)
                       : yuv_to_rgb_limited(y, chroma.r, chroma.g);
  } else {
    rgb = linear_to_srgb(texture(srcY, uv).rgb);
  }
  imageStore(dst, p, vec4(rgb, 1.0));
}
